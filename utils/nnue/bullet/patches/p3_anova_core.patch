@@ -0,0 +1,97 @@
+use crate::device::{Device, OperationError, function::DeviceOperation, operation::P3AnovaOps, tensor::TensorRef};
+
+#[derive(Clone)]
+pub struct P3Anova<D: Device> {
+    pub pawn_weights: TensorRef<D>,
+    pub context_weights: TensorRef<D>,
+    pub indices: TensorRef<D>,
+    pub pawn_offset: usize,
+    pub pawn_count: usize,
+    pub context_offset: usize,
+    pub context_count: usize,
+    pub rank: usize,
+    pub output: TensorRef<D>,
+}
+
+impl<D: P3AnovaOps> DeviceOperation<D> for P3Anova<D> {
+    fn opname(&self) -> String {
+        "P3Anova".to_string()
+    }
+
+    fn execute(&self) -> Result<(), OperationError<D::DeviceError>> {
+        let pawns = self.pawn_weights.dense();
+        let context = self.context_weights.dense();
+        let indices = self.indices.sparse();
+        let mut output = self.output.dense_mut();
+        let batch_size = indices.batch_size();
+
+        if batch_size != output.batch_size() {
+            return Err(OperationError::MismatchedBatchSizes);
+        }
+
+        D::p3_anova(
+            batch_size.unwrap_or(1),
+            indices.nnz(),
+            self.rank,
+            self.pawn_offset,
+            self.pawn_count,
+            self.context_offset,
+            self.context_count,
+            &pawns.buf,
+            &context.buf,
+            &indices.buf,
+            &mut output.buf,
+        )
+    }
+}
+
+#[derive(Clone)]
+pub struct BackpropP3Anova<D: Device> {
+    pub pawn_weights: TensorRef<D>,
+    pub context_weights: TensorRef<D>,
+    pub indices: TensorRef<D>,
+    pub pawn_offset: usize,
+    pub pawn_count: usize,
+    pub context_offset: usize,
+    pub context_count: usize,
+    pub rank: usize,
+    pub output_grads: TensorRef<D>,
+    pub pawn_weight_grads: TensorRef<D>,
+    pub context_weight_grads: TensorRef<D>,
+}
+
+impl<D: P3AnovaOps> DeviceOperation<D> for BackpropP3Anova<D> {
+    fn opname(&self) -> String {
+        "BackpropP3Anova".to_string()
+    }
+
+    fn execute(&self) -> Result<(), OperationError<D::DeviceError>> {
+        let pawns = self.pawn_weights.dense();
+        let context = self.context_weights.dense();
+        let indices = self.indices.sparse();
+        let output_grads = self.output_grads.dense();
+        let mut pawn_grads = self.pawn_weight_grads.dense_mut();
+        let mut context_grads = self.context_weight_grads.dense_mut();
+        let batch_size = indices.batch_size();
+
+        if batch_size != output_grads.batch_size() {
+            return Err(OperationError::MismatchedBatchSizes);
+        }
+
+        D::backprop_p3_anova(
+            batch_size.unwrap_or(1),
+            indices.nnz(),
+            self.rank,
+            self.pawn_offset,
+            self.pawn_count,
+            self.context_offset,
+            self.context_count,
+            &pawns.buf,
+            &context.buf,
+            &indices.buf,
+            &output_grads.buf,
+            &mut pawn_grads.buf,
+            &mut context_grads.buf,
+        )
+    }
+}
