+use crate::device::{Device, OperationResult};
+
+#[allow(clippy::too_many_arguments)]
+pub trait P3AnovaOps: Device {
+    fn p3_anova(
+        batch_size: usize,
+        nnz: usize,
+        rank: usize,
+        pawn_offset: usize,
+        pawn_count: usize,
+        context_offset: usize,
+        context_count: usize,
+        pawn_weights: &Self::BufferF32,
+        context_weights: &Self::BufferF32,
+        indices: &Self::BufferI32,
+        output: &mut Self::BufferF32,
+    ) -> OperationResult<Self::DeviceError>;
+
+    fn backprop_p3_anova(
+        batch_size: usize,
+        nnz: usize,
+        rank: usize,
+        pawn_offset: usize,
+        pawn_count: usize,
+        context_offset: usize,
+        context_count: usize,
+        pawn_weights: &Self::BufferF32,
+        context_weights: &Self::BufferF32,
+        indices: &Self::BufferI32,
+        output_grads: &Self::BufferF32,
+        pawn_weight_grads: &mut Self::BufferF32,
+        context_weight_grads: &mut Self::BufferF32,
+    ) -> OperationResult<Self::DeviceError>;
+}
