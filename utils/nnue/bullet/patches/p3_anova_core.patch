new file mode 100644
index 0000000..2e759ba
--- /dev/null
+++ b/crates/acyclib/src/graph/ir/operation/p3.rs
@@ -0,0 +1,122 @@
+use crate::{
+    dag::NodeId,
+    device::{
+        Device,
+        function::{self, DeviceFunction, DeviceOperation},
+        operation::P3AnovaOps,
+        tensor::Shape,
+    },
+    graph::{
+        Graph, GraphNodeIdTy,
+        ir::{
+            BackendMarker, GraphIR, GraphIRError,
+            node::AnnotatedNode,
+            operation::{GraphIROperationBase, GraphIROperationCompilable, GraphIROperationError, util},
+        },
+    },
+};
+
+pub trait P3AnovaImpl: Device {
+    type Fwd: DeviceOperation<Self>;
+    type Bwd: DeviceOperation<Self>;
+
+    fn p3_fwd(op: function::P3Anova<Self>) -> Self::Fwd;
+    fn p3_bwd(op: function::BackpropP3Anova<Self>) -> Self::Bwd;
+}
+
+impl<D: P3AnovaOps> P3AnovaImpl for D {
+    type Fwd = function::P3Anova<Self>;
+    type Bwd = function::BackpropP3Anova<Self>;
+
+    fn p3_fwd(op: function::P3Anova<Self>) -> Self::Fwd {
+        op
+    }
+
+    fn p3_bwd(op: function::BackpropP3Anova<Self>) -> Self::Bwd {
+        op
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct P3Anova {
+    pub pawn_weights: AnnotatedNode,
+    pub context_weights: AnnotatedNode,
+    pub indices: AnnotatedNode,
+    pub pawn_offset: usize,
+    pub pawn_count: usize,
+    pub context_offset: usize,
+    pub context_count: usize,
+    pub rank: usize,
+}
+
+impl<B: BackendMarker> GraphIROperationBase<B> for P3Anova {
+    fn nodes(&self) -> Vec<AnnotatedNode> {
+        vec![self.pawn_weights, self.context_weights, self.indices]
+    }
+
+    fn output_shape(&self, ir: &GraphIR<B>) -> Result<Shape, GraphIRError> {
+        util::check_dense_eq(ir, &self.pawn_weights, true)?;
+        util::check_dense_eq(ir, &self.context_weights, true)?;
+        util::check_dense_eq(ir, &self.indices, false)?;
+        util::check_not_batched(ir, &self.pawn_weights)?;
+        util::check_not_batched(ir, &self.context_weights)?;
+        util::check_no_grad(ir, &[&self.indices])?;
+
+        let valid = self.rank > 0
+            && self.indices.shape.cols() == 1
+            && self.pawn_weights.shape == Shape::new(self.rank, self.pawn_count)
+            && self.context_weights.shape == Shape::new(self.rank, self.context_count)
+            && self.pawn_offset.checked_add(self.pawn_count).is_some_and(|end| end <= self.indices.shape.rows())
+            && self.context_offset.checked_add(self.context_count).is_some_and(|end| end <= self.indices.shape.rows());
+
+        valid
+            .then_some(Shape::new(2 * self.rank, 1))
+            .ok_or(GraphIRError::Op(GraphIROperationError::InvalidInputShape(self.indices.shape)))
+    }
+
+    fn shorthand(&self) -> String {
+        format!("P3Anova(R{})", self.rank)
+    }
+}
+
+impl<B: BackendMarker> GraphIROperationCompilable<B> for P3Anova
+where
+    B::Backend: P3AnovaImpl,
+{
+    fn forward_pass(&self, graph: &Graph<B::Backend>, output_node: NodeId) -> DeviceFunction<B::Backend> {
+        let indices = graph.get_ref(self.indices.idx, GraphNodeIdTy::Values);
+        let output = graph.get_ref(output_node, GraphNodeIdTy::Values);
+        let mut func = DeviceFunction::default();
+        func.push(function::MaybeUpdateBatchSize { input: indices.clone(), output: output.clone() });
+        func.push(<B::Backend as P3AnovaImpl>::p3_fwd(function::P3Anova {
+            pawn_weights: graph.get_ref(self.pawn_weights.idx, GraphNodeIdTy::Values),
+            context_weights: graph.get_ref(self.context_weights.idx, GraphNodeIdTy::Values),
+            indices,
+            pawn_offset: self.pawn_offset,
+            pawn_count: self.pawn_count,
+            context_offset: self.context_offset,
+            context_count: self.context_count,
+            rank: self.rank,
+            output,
+        }));
+        func
+    }
+
+    fn backward_pass(&self, graph: &Graph<B::Backend>, output_node: NodeId) -> DeviceFunction<B::Backend> {
+        let mut func = DeviceFunction::default();
+        func.push(<B::Backend as P3AnovaImpl>::p3_bwd(function::BackpropP3Anova {
+            pawn_weights: graph.get_ref(self.pawn_weights.idx, GraphNodeIdTy::Values),
+            context_weights: graph.get_ref(self.context_weights.idx, GraphNodeIdTy::Values),
+            indices: graph.get_ref(self.indices.idx, GraphNodeIdTy::Values),
+            pawn_offset: self.pawn_offset,
+            pawn_count: self.pawn_count,
+            context_offset: self.context_offset,
+            context_count: self.context_count,
+            rank: self.rank,
+            output_grads: graph.get_ref(output_node, GraphNodeIdTy::Gradients),
+            pawn_weight_grads: graph.get_ref(self.pawn_weights.idx, GraphNodeIdTy::Gradients),
+            context_weight_grads: graph.get_ref(self.context_weights.idx, GraphNodeIdTy::Gradients),
+        }));
+        func
+    }
+}
