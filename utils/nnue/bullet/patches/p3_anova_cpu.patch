+#![allow(clippy::too_many_arguments)]
+
+use crate::device::{DeviceBuffer, OperationError, OperationResult, cpu::CpuThread, operation::P3AnovaOps};
+
+fn pawn_file(identity: usize) -> usize {
+    (identity % 64) % 8
+}
+
+fn p3_forward_position(
+    rank: usize,
+    pawn_offset: usize,
+    pawn_count: usize,
+    context_offset: usize,
+    context_count: usize,
+    pawn_weights: &[f32],
+    context_weights: &[f32],
+    indices: &[i32],
+    output: &mut [f32],
+) {
+    for r in 0..rank {
+        let mut sums = [0.0_f32; 8];
+        let mut squares = [0.0_f32; 8];
+        let mut context = 0.0_f32;
+
+        for &index in indices {
+            let Ok(index) = usize::try_from(index) else {
+                break;
+            };
+            if (pawn_offset..pawn_offset + pawn_count).contains(&index) {
+                let identity = index - pawn_offset;
+                let value = pawn_weights[identity * rank + r];
+                let file = pawn_file(identity);
+                sums[file] += value;
+                squares[file] += value * value;
+            } else if (context_offset..context_offset + context_count).contains(&index) {
+                context += context_weights[(index - context_offset) * rank + r];
+            } else {
+                break;
+            }
+        }
+
+        let mut same = 0.0_f32;
+        let mut adjacent = 0.0_f32;
+        for file in 0..8 {
+            same += 0.5 * (sums[file] * sums[file] - squares[file]);
+            if file < 7 {
+                adjacent += sums[file] * sums[file + 1];
+            }
+        }
+        output[r] = same * context;
+        output[rank + r] = adjacent * context;
+    }
+}
+
+fn p3_backward_position(
+    rank: usize,
+    pawn_offset: usize,
+    pawn_count: usize,
+    context_offset: usize,
+    context_count: usize,
+    pawn_weights: &[f32],
+    context_weights: &[f32],
+    indices: &[i32],
+    output_grads: &[f32],
+    pawn_grads: &mut [f32],
+    context_grads: &mut [f32],
+) {
+    for r in 0..rank {
+        let mut sums = [0.0_f32; 8];
+        let mut squares = [0.0_f32; 8];
+        let mut context = 0.0_f32;
+
+        for &index in indices {
+            let Ok(index) = usize::try_from(index) else {
+                break;
+            };
+            if (pawn_offset..pawn_offset + pawn_count).contains(&index) {
+                let identity = index - pawn_offset;
+                let value = pawn_weights[identity * rank + r];
+                let file = pawn_file(identity);
+                sums[file] += value;
+                squares[file] += value * value;
+            } else if (context_offset..context_offset + context_count).contains(&index) {
+                context += context_weights[(index - context_offset) * rank + r];
+            } else {
+                break;
+            }
+        }
+
+        let mut same = 0.0_f32;
+        let mut adjacent = 0.0_f32;
+        for file in 0..8 {
+            same += 0.5 * (sums[file] * sums[file] - squares[file]);
+            if file < 7 {
+                adjacent += sums[file] * sums[file + 1];
+            }
+        }
+
+        let d_same = output_grads[r] * context;
+        let d_adjacent = output_grads[rank + r] * context;
+        let d_context = output_grads[r] * same + output_grads[rank + r] * adjacent;
+
+        for &index in indices {
+            let Ok(index) = usize::try_from(index) else {
+                break;
+            };
+            if (pawn_offset..pawn_offset + pawn_count).contains(&index) {
+                let identity = index - pawn_offset;
+                let file = pawn_file(identity);
+                let value = pawn_weights[identity * rank + r];
+                let neighbours =
+                    if file == 0 { 0.0 } else { sums[file - 1] } + if file == 7 { 0.0 } else { sums[file + 1] };
+                pawn_grads[identity * rank + r] += d_same * (sums[file] - value) + d_adjacent * neighbours;
+            } else if (context_offset..context_offset + context_count).contains(&index) {
+                context_grads[(index - context_offset) * rank + r] += d_context;
+            } else {
+                break;
+            }
+        }
+    }
+}
+
+impl P3AnovaOps for CpuThread {
+    fn p3_anova(
+        batch_size: usize,
+        nnz: usize,
+        rank: usize,
+        pawn_offset: usize,
+        pawn_count: usize,
+        context_offset: usize,
+        context_count: usize,
+        pawn_weights: &Self::BufferF32,
+        context_weights: &Self::BufferF32,
+        indices: &Self::BufferI32,
+        output: &mut Self::BufferF32,
+    ) -> OperationResult<Self::DeviceError> {
+        if pawn_weights.size() < pawn_count * rank
+            || context_weights.size() < context_count * rank
+            || indices.size() < batch_size * nnz
+            || output.size() < batch_size * 2 * rank
+        {
+            return Err(OperationError::IndexOutOfBounds);
+        }
+
+        for loc in 0..batch_size {
+            p3_forward_position(
+                rank,
+                pawn_offset,
+                pawn_count,
+                context_offset,
+                context_count,
+                &pawn_weights.buf,
+                &context_weights.buf,
+                &indices.buf[loc * nnz..(loc + 1) * nnz],
+                &mut output.buf[loc * 2 * rank..(loc + 1) * 2 * rank],
+            );
+        }
+        Ok(())
+    }
+
+    fn backprop_p3_anova(
+        batch_size: usize,
+        nnz: usize,
+        rank: usize,
+        pawn_offset: usize,
+        pawn_count: usize,
+        context_offset: usize,
+        context_count: usize,
+        pawn_weights: &Self::BufferF32,
+        context_weights: &Self::BufferF32,
+        indices: &Self::BufferI32,
+        output_grads: &Self::BufferF32,
+        pawn_weight_grads: &mut Self::BufferF32,
+        context_weight_grads: &mut Self::BufferF32,
+    ) -> OperationResult<Self::DeviceError> {
+        if pawn_weights.size() < pawn_count * rank
+            || context_weights.size() < context_count * rank
+            || indices.size() < batch_size * nnz
+            || output_grads.size() < batch_size * 2 * rank
+            || pawn_weight_grads.size() < pawn_count * rank
+            || context_weight_grads.size() < context_count * rank
+        {
+            return Err(OperationError::IndexOutOfBounds);
+        }
+
+        for loc in 0..batch_size {
+            p3_backward_position(
+                rank,
+                pawn_offset,
+                pawn_count,
+                context_offset,
+                context_count,
+                &pawn_weights.buf,
+                &context_weights.buf,
+                &indices.buf[loc * nnz..(loc + 1) * nnz],
+                &output_grads.buf[loc * 2 * rank..(loc + 1) * 2 * rank],
+                &mut pawn_weight_grads.buf,
+                &mut context_weight_grads.buf,
+            );
+        }
+        Ok(())
+    }
+}
