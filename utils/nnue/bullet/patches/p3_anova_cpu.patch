+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const RANK: usize = 2;
+    const PAWN_OFFSET: usize = 100;
+    const PAWN_COUNT: usize = 128;
+    const CONTEXT_OFFSET: usize = 228;
+    const CONTEXT_COUNT: usize = 4;
+
+    fn objective(pawns: &[f32], context: &[f32], indices: &[i32], output_grads: &[f32]) -> f32 {
+        let mut output = [0.0; 2 * RANK];
+        p3_forward_position(
+            RANK,
+            PAWN_OFFSET,
+            PAWN_COUNT,
+            CONTEXT_OFFSET,
+            CONTEXT_COUNT,
+            pawns,
+            context,
+            indices,
+            &mut output,
+        );
+        output.iter().zip(output_grads).map(|(a, b)| a * b).sum()
+    }
+
+    #[test]
+    fn moments_match_brute_force_distinct_pairs() {
+        let mut pawns = vec![0.0; PAWN_COUNT * RANK];
+        let mut context = vec![0.0; CONTEXT_COUNT * RANK];
+        let identities = [8, 16, 17, 26]; // two file-a, file-b, and file-c pawns
+        for (n, &identity) in identities.iter().enumerate() {
+            pawns[identity * RANK] = 0.2 + n as f32 * 0.1;
+            pawns[identity * RANK + 1] = -0.4 + n as f32 * 0.07;
+        }
+        context[0] = 0.5;
+        context[1] = -0.25;
+        context[2] = -0.1;
+        context[3] = 0.8;
+        let indices = [
+            PAWN_OFFSET as i32 + 8,
+            PAWN_OFFSET as i32 + 16,
+            PAWN_OFFSET as i32 + 17,
+            PAWN_OFFSET as i32 + 26,
+            CONTEXT_OFFSET as i32,
+            CONTEXT_OFFSET as i32 + 1,
+            -1,
+        ];
+        let mut actual = [0.0; 2 * RANK];
+        p3_forward_position(
+            RANK,
+            PAWN_OFFSET,
+            PAWN_COUNT,
+            CONTEXT_OFFSET,
+            CONTEXT_COUNT,
+            &pawns,
+            &context,
+            &indices,
+            &mut actual,
+        );
+
+        let mut expected = [0.0; 2 * RANK];
+        for r in 0..RANK {
+            let c = context[r] + context[RANK + r];
+            for i in 0..identities.len() {
+                for j in i + 1..identities.len() {
+                    let a = identities[i];
+                    let b = identities[j];
+                    let product = pawns[a * RANK + r] * pawns[b * RANK + r] * c;
+                    match pawn_file(a).abs_diff(pawn_file(b)) {
+                        0 => expected[r] += product,
+                        1 => expected[RANK + r] += product,
+                        _ => {}
+                    }
+                }
+            }
+        }
+        for (a, b) in actual.into_iter().zip(expected) {
+            assert!((a - b).abs() < 1.0e-6, "{a} != {b}");
+        }
+    }
+
+    #[test]
+    fn backward_matches_central_difference() {
+        let mut pawns = vec![0.0; PAWN_COUNT * RANK];
+        let mut context = vec![0.0; CONTEXT_COUNT * RANK];
+        for (identity, values) in [(8, [0.2, -0.3]), (16, [-0.4, 0.6]), (17, [0.7, 0.1])] {
+            pawns[identity * RANK..identity * RANK + RANK].copy_from_slice(&values);
+        }
+        context[..4].copy_from_slice(&[0.5, -0.2, 0.3, 0.9]);
+        let indices = [
+            PAWN_OFFSET as i32 + 8,
+            PAWN_OFFSET as i32 + 16,
+            PAWN_OFFSET as i32 + 17,
+            CONTEXT_OFFSET as i32,
+            CONTEXT_OFFSET as i32 + 1,
+            -1,
+        ];
+        let output_grads = [0.7, -0.5, 0.2, 0.9];
+        let mut pawn_grads = vec![0.0; pawns.len()];
+        let mut context_grads = vec![0.0; context.len()];
+        p3_backward_position(
+            RANK,
+            PAWN_OFFSET,
+            PAWN_COUNT,
+            CONTEXT_OFFSET,
+            CONTEXT_COUNT,
+            &pawns,
+            &context,
+            &indices,
+            &output_grads,
+            &mut pawn_grads,
+            &mut context_grads,
+        );
+
+        let epsilon = 1.0e-3;
+        for index in [8 * RANK, 8 * RANK + 1, 16 * RANK, 17 * RANK + 1] {
+            let original = pawns[index];
+            pawns[index] = original + epsilon;
+            let plus = objective(&pawns, &context, &indices, &output_grads);
+            pawns[index] = original - epsilon;
+            let minus = objective(&pawns, &context, &indices, &output_grads);
+            pawns[index] = original;
+            let numerical = (plus - minus) / (2.0 * epsilon);
+            assert!((pawn_grads[index] - numerical).abs() < 2.0e-4);
+        }
+        for index in 0..4 {
+            let original = context[index];
+            context[index] = original + epsilon;
+            let plus = objective(&pawns, &context, &indices, &output_grads);
+            context[index] = original - epsilon;
+            let minus = objective(&pawns, &context, &indices, &output_grads);
+            context[index] = original;
+            let numerical = (plus - minus) / (2.0 * epsilon);
+            assert!((context_grads[index] - numerical).abs() < 2.0e-4);
+        }
+    }
+}
